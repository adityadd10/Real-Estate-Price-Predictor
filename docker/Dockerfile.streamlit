# Streamlit UI image. No sklearn/xgboost/snowflake-connector here — the UI
# only ever talks to the API over HTTP (see streamlit_app/api_client.py).
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements/streamlit.txt requirements/
RUN pip install --no-cache-dir -r requirements/streamlit.txt

COPY streamlit_app/ streamlit_app/

ENV PYTHONUNBUFFERED=1

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "streamlit_app/Home_Page.py", "--server.port=8501", "--server.address=0.0.0.0"]
