# Copy this file to .env and fill in your values. Never commit .env.

# --- Snowflake (leave blank to fall back to local CSVs under data/raw/) ---
SNOWFLAKE_ACCOUNT=xxxxxxx-xxxxxxx
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=REAL_ESTATE_WH
SNOWFLAKE_DATABASE=REAL_ESTATE
SNOWFLAKE_SCHEMA=GURGAON

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=gurgaon-price-prediction

# --- Service wiring ---
# Used by the Streamlit app to reach the API. In docker-compose this is set
# to http://api:8000 (the service name); locally use http://localhost:8000.
API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
