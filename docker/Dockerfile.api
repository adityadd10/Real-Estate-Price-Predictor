# FastAPI model-serving image. Deliberately does NOT install streamlit/plotly/
# matplotlib/seaborn/wordcloud — those belong to the UI image only.
FROM python:3.11-slim AS base

WORKDIR /app

# System deps: xgboost/scikit-learn wheels are manylinux, but keep libgomp1
# around since xgboost's OpenMP runtime needs it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements/api.txt requirements/
RUN pip install --no-cache-dir -r requirements/api.txt

COPY src/ src/
COPY api/ api/
COPY artifacts/recommendation/ artifacts/recommendation/
COPY data/raw/ data/raw/

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
